// Jenkinsfile.pr-hook — PR 拦截 + 失败自动建 Jira bug
// 实战场景：
//   - GitHub PR 提交 → Jenkins 自动跑测试 + Sonar → 不通过直接拒绝合并
//   - 测试失败 → 自动建 Jira bug → 自动 @ 责任人
//
// 前置准备：
//   1) GitHub repo → Settings → Webhooks → 指向 Jenkins 的 GH hook URL
//   2) Jenkins 装 GitHub Integration 插件 + Pipeline: Multibranch 插件
//   3) Manage Jenkins → Credentials → 添加 jira-token（PAT 类型）
//
// 简历可写："搭建 PR 自动测试+卡口+失败建缺陷全链路，PR 平均合并时间从 4h 降至 30min"

pipeline {
    agent any

    options {
        timestamps()
        timeout(time: 30, unit: 'MINUTES')
    }

    // PR 拦截：当 PR 触发时跑这个 pipeline
    triggers {
        // 不需要定时触发，PR 触发即可
    }

    environment {
        // PR 信息从 GitHub plugin 自动注入
        PR_NUMBER  = "${env.CHANGE_ID}"
        PR_AUTHOR  = "${env.CHANGE_AUTHOR}"
        PR_TITLE   = "${env.CHANGE_TITLE}"
        PR_URL     = "${env.CHANGE_URL}"
        PR_TARGET  = "${env.CHANGE_TARGET}"

        // Jira 配置（用凭据避免明文）
        JIRA_BASE_URL    = 'https://your-company.atlassian.net'
        JIRA_PROJECT_KEY = 'QA'
        JIRA_TOKEN       = credentials('jira-token')
    }

    stages {
        stage('PR 拦截开关') {
            steps {
                script {
                    if (!env.CHANGE_ID) {
                        error "❌ 这个 pipeline 只在 PR 触发时执行（CHANGE_ID 缺失）"
                    }
                    echo "🔍 正在审查 PR #${PR_NUMBER} from ${PR_AUTHOR}: ${PR_TITLE}"
                }
            }
        }

        stage('Checkout PR 代码') {
            steps {
                checkout scm
            }
        }

        // 必须先跑的快速检查：lint + 单测 + 静态扫描
        stage('质量门禁（快速）') {
            parallel {
                stage('代码风格') {
                    steps {
                        sh '''
                            python3 -m pip install -q flake8
                            flake8 app/ automation/ --max-line-length=120 || exit 1
                        '''
                    }
                }
                stage('单元测试') {
                    steps {
                        dir('automation') {
                            sh '''
                                python3 -m pytest test_api_login.py --alluredir=reports/unit
                            '''
                        }
                    }
                }
                stage('接口冒烟') {
                    steps {
                        dir('app') {
                            sh '''
                                python3 -m pip install -q flask
                                nohup python3 server.py > /tmp/srv.log 2>&1 &
                                sleep 3
                                curl -fsS http://127.0.0.1:5000/api/products > /dev/null
                                pkill -f "python3 server.py" || true
                            '''
                        }
                    }
                }
            }
        }
    }

    post {
        failure {
            // ⭐ 核心：CI 失败自动建 Jira bug，附带 PR 信息 + 日志链接
            script {
                try {
                    def auth = "${JIRA_TOKEN}"
                    def body = """
                    {
                        "fields": {
                            "project": {"key": "${JIRA_PROJECT_KEY}"},
                            "summary": "[PR#${PR_NUMBER}] ${PR_AUTHOR} 接口自动化失败",
                            "description": "PR: ${PR_URL}\\n\\nTitle: ${PR_TITLE}\\nAuthor: ${PR_AUTHOR}\\nBuild: ${env.BUILD_URL}\\n\\n请 @ ${PR_AUTHOR} 修复。",
                            "issuetype": {"name": "Bug"},
                            "labels": ["auto-test", "pr-blocker"]
                        }
                    }
                    """
                    def response = httpRequest(
                        url: "${JIRA_BASE_URL}/rest/api/2/issue",
                        httpMode: 'POST',
                        customHeaders: [[name: 'Authorization', value: "Bearer ${auth}"]],
                        contentType: 'APPLICATION_JSON',
                        requestBody: body
                    )
                    def issueKey = readJSON(text: response.content).key
                    echo "✅ Jira bug 已建: ${JIRA_BASE_URL}/browse/${issueKey}"

                    // 可选：在 PR 上评论通知
                    // githubComment body: "❌ 自动测试失败，已建 Jira: ${issueKey}"
                } catch (e) {
                    echo "⚠️ Jira 调用失败（不影响 pipeline 状态）: ${e}"
                }
            }

            // 通过 GitHub Status API 给 PR 标红，阻止合并
            // 需要装 GitHub Status 插件：ghStatusSetter
            // ghStatusSetter status: 'failure', description: 'Jenkins CI 失败', context: 'jenkins/auto-test'
        }

        success {
            echo "✅ PR #${PR_NUMBER} 测试通过，可合并"
            // ghStatusSetter status: 'success', description: 'Jenkins CI 通过', context: 'jenkins/auto-test'
        }
    }
}

// ============================================================
// 面试话术（被问到"PR 卡口怎么做"时直接讲）：
// ============================================================
// "GitHub webhook → Jenkins multibranch pipeline → 触发这个 Jenkinsfile →
//  跑 lint + 单测 + 接口冒烟（三件并行） → 失败自动建 Jira bug + 给 PR 标红 →
//  GitHub PR 自动禁止合并（Settings → Branches → Require status checks）。
//
//  关键点：建 Jira 那段我加 try/catch，不会因为 Jira 调用失败影响 CI 本身的状态——
//  这是工程化的细节，很多团队踩坑（Jira 一挂 CI 全挂）。"
//
// 追问："怎么保证 Jira bug 一定 @ 到责任人？"
// 答：在 Jira API 提交时设 assignee 字段（动态读 PR 作者）。
//     或者用 Jira webhook → 飞书/钉钉机器人推送到个人。
// ============================================================

// ============================================================
// GitHub + Jenkins 端到端配置步骤（按顺序执行，配完即可用）
// ============================================================
//
// ## 步骤 1：生成 GitHub Personal Access Token
//
// 1. GitHub 右上角头像 → Settings → Developer settings（页面最下面）
// 2. Personal access tokens → Tokens (classic) → Generate new token
// 3. Note 填 "Jenkins CI Integration"
// 4. Expiration 选 90 天（生产建议配 renew secret 自动续期）
// 5. 权限勾选（最精简够用集）：
//      ✅ repo              (读仓库)
//      ✅ write:repo_hook   (写 webhook)
//      ✅ read:user         (读作者信息)
//      ✅ project           (关联 project)
// 6. 点 Generate token → 复制 token（关页面就再也看不见）
//
// ## 步骤 2：在 Jenkins 里加凭据
//
// 1. Jenkins 主页 → Manage Jenkins → Credentials → (global) → Add Credentials
// 2. Kind 选 "Secret text"
// 3. Secret 粘贴上一步的 token
// 4. ID 填 "github-token"
// 5. Description "GitHub PAT for Jenkins"
// 6. 保存
//
// ## 步骤 3：装 Jenkins 插件
//
// Manage Jenkins → Plugins → Available plugins，搜索并装：
//   ✅ Pipeline                          // 一般预装了
//   ✅ GitHub Branch Source Plugin       // PR 检测
//   ✅ Pipeline: GitHub                  // pipelineTriggers 用
//   ✅ GitHub Checks Plugin              // ghStatusSetter 标红 PR
//   ✅ JIRA Pipeline Steps (optional)   // jiraSend / jiraInfo
//
// 装完重启 Jenkins（或选择不重启立刻生效，看版本）。
//
// ## 步骤 4：Jira 凭据（同 GitHub PAT 思路）
//
// 同步骤 2，但填 Jira API token：
// 1. Atlassian → Account settings → Security → API tokens → Create token
// 2. Jenkins → Add Credentials → Secret text → ID 填 "jira-token"
//
// ## 步骤 5：建 Multibranch Pipeline Job
//
// 1. Jenkins 主页 → New Item
// 2. 名字 "minimall-pr-check"
// 3. 类型选 "Multibranch Pipeline"
// 4. Branch Sources → Add source → GitHub
// 5. Credentials 选 "github-token"（上一步建的）
// 6. Repository HTTPS URL 填 https://github.com/<your-user>/mini-mall-test
// 7. Behaviors 勾：
//      ✅ Discover PRs
//      ✅ Build PRs from forks with enabled PR build whitelist  （可选）
//      ✅ Filter by name (with wildcards) 改为 "main" 和 "dev/*"
//      ✅ Strategy: Jenkinsfile
// 8. Script Path 默认 "Jenkinsfile"（这个文件就叫这个名）
// 9. 保存。Jenkins 自动扫仓库，建一条 main 分支 + 看到 PR 自动触发 build。
//
// ## 步骤 6：GitHub 仓库端开 Branch Protection
//
// 1. GitHub 仓库 → Settings → Branches → Add rule
// 2. Branch name pattern 填 "main"
// 3. 勾选：
//      ✅ Require status checks to pass before merging
//      ✅ Require branches to be up to date before merging
//      ✅ Require conversation resolution before merging
// 4. Status checks 里搜索 "jenkins" 把 jenkins/auto-test 勾上（这一步必须等 PR 跑过一次才会出现）
// 5. 保存——这下任何人提 PR 都没法绕过 CI 合并了。
//
// ## 端到端测试（验证闭环）
//
// 1. 在 main 分支改一行 README.md，提交
// 2. 在 GitHub 上提个 PR
// 3. 几秒内 Jenkins multibranch 任务里出现这条 PR
// 4. 看 build 日志：PR 拦截开关 → 质量门禁三件并行 → 全部通过
// 5. 回到 GitHub PR 页 → 看到 "All checks passed" 绿色 ✅
// 6. 大胆 merge，验证通过
//
// ## 故意失败看看效果
//
// 1. 故意在 server.py 里加一行语法错误，提交 PR
// 2. CI 必失败 → post.failure 触发 Jira 建单
// 3. Slack 收到通知
// 4. PR 页"3 checks"显示红叉，merge 按钮变灰
// 5. 修复提交 → 自动重跑 → 通过
// ============================================================

// ## 常见踩坑（提前知道省 2 小时排查）
//
// 1. PR 页看不到 Jenkins 状态：
//    → 没装 GitHub Checks 插件，或 Jenkins URL 在 GitHub webhook 配置错了
//    → 验证：浏览器开发者工具 Network → 找 "checks" 的 HTTP 200/404
//
// 2. Jira API 401 Unauthorized：
//    → API token 过期或复制时多了空格
//    → 验证：curl 测试 Atlassian API 是否能通
//
// 3. Jenkins pipeline 跑 main 分支也跑了 PR 拦截：
//    → when { changeRequest() } 没写或写错，main 也会跑
//    → 检查：日志第一行应该有 "🔍 正在审查 PR #${PR_NUMBER}"，没显示就是 context 错
//
// 4. 个人仓库（Gitee / 自建 GitLab）跑不起来：
//    → Jenkinsfile 里假设 GitHub，理论上 GitLab CI 用 .gitlab-ci.yml，不是这套
//    → Jenkins 也能对接 GitLab，但要装 GitLab Plugin
// ============================================================